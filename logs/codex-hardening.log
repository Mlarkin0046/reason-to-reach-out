  $('#copyButton').onclick=async()=>{try{await navigator.clipboard.writeText($('#messageText').textContent);$('#copyButton').textContent='Copied';track('wording_copied');setTimeout(()=>$('#copyButton').textContent='Copy wording',1200);}catch{$('#copyButton').textContent='Select and copy';}};
  $('#downloadPdf').onclick=()=>{$('#ownerFirstName').value=state.input.firstName||'';$('#captureOverlay').classList.add('show');}; $('#closeModal').onclick=()=>$('#captureOverlay').classList.remove('show');
  async function createPdf(){const {PDFDocument,StandardFonts,rgb}=window.PDFLib;const doc=await PDFDocument.create(),font=await doc.embedFont(StandardFonts.Helvetica),bold=await doc.embedFont(StandardFonts.HelveticaBold);const add=(title,lines)=>{let p=doc.addPage([612,792]),y=744;const header=()=>{p.drawText(title,{x:44,y,size:18,font:bold,color:rgb(.08,.16,.28)});y-=34;};header();for(const line of lines){for(const chunk of String(line).match(/.{1,88}(?:\s|$)/g)||['']){if(y<48){p=doc.addPage([612,792]);y=744;header();}p.drawText(chunk.trim(),{x:44,y,size:9,font});y-=13;}y-=6;}};add(`${state.input.company} — Reason to Reach Out`,[state.data.diagnosis,...(state.data.assumptions||[]).map(x=>`Assumption: ${x}`)]);state.data.plays.forEach(p=>add(`${p.rank}. ${p.title} — ${p.rubric.total}/10`,[`Relevance ${p.rubric.relevance}/2 · Newness ${p.rubric.newness}/2 · Value ${p.rubric.value}/2 · Decision help ${p.rubric.decisionHelp}/2 · Prospect benefit ${p.rubric.prospectBenefit}/2`,p.strategicAngle,p.whyNow,p.valueToBring,`Primary channel: ${p.primaryChannel}`,...p.sequence.map((x,i)=>`${i+1}. ${x}`),p.rationale,...CHANNELS.map(c=>`${c}: ${p.scripts[c]}`)]));const selected=state.data.plays[state.selected],physical=['Mailed card','Gift/leave-behind'].includes(selected.primaryChannel);add('Talk to Mike — Airstrike Marketing',[physical?'Want help making the physical follow-up memorable? Talk to Mike about a thoughtful card, modest gift, or leave-behind that fits the relationship.':'Want another set of eyes? Talk to Mike about sharpening the reason, sequence, or wording.',`Phone: ${PHONE_DISPLAY}`,`Email: ${CONTACT_EMAIL}`,`Book: ${BOOKING_URL}`,...(physical?[`Video: ${VIDEO_URL}`,`Mailbox Power: ${MAILBOX_URL}`,'Recommendations only. Review the prospect’s gift and vendor policies before sending anything.']:[])]);const bytes=await doc.save();const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([bytes],{type:'application/pdf'}));a.download='reason-to-reach-out.pdf';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);}
  $('#contactForm').onsubmit=async(e)=>{e.preventDefault();if(!e.currentTarget.reportValidity())return;const email=$('#ownerEmail').value.trim().toLowerCase();state.email=email;sessionStorage.setItem('rtro_email',email);await track('lead_capture',{firstName:$('#ownerFirstName').value.trim(),email,company:$('#ownerCompany').value.trim(),consent:$('#nurtureConsent').checked});try{await createPdf();track('pdf_downloaded',{score:state.data.plays[state.selected].rubric.total});}finally{$('#captureOverlay').classList.remove('show');}};
  document.querySelectorAll('[data-feedback]').forEach(b=>b.onclick=()=>{state.feedback=b.dataset.feedback;$('#feedbackDetail').classList.add('show');$('#feedbackMissing').focus();});$('#feedbackSubmit').onclick=()=>{track('feedback',{answer:state.feedback,missing:$('#feedbackMissing').value.trim(),score:state.data.plays[state.selected].rubric.total});$('#feedbackDetail').classList.remove('show');$('.feedback-buttons').style.display='none';$('#feedbackThanks').textContent='Thanks—your feedback helps improve the tool.';};
  function applyRun(run){try{const data=typeof run==='string'?JSON.parse(run):run;if(!data)return;const map={firstName:'firstName',relationship:'relationship',stage:'stage',company:'company',prospectName:'prospectName',prospectRole:'prospectRole',situation:'situation',priority:'priority',lastContact:'lastContact',trigger:'trigger',desiredNextStep:'nextStep',nextStep:'nextStep'};Object.entries(map).forEach(([k,id])=>{if(data[k]!=null)$(`#${id}`).value=data[k]});if($('#firstName').value&&$('#company').value&&$('#situation').value)$('#reasonForm').requestSubmit();}catch(error){if(typeof window.ASOS_FAIL==='function')window.ASOS_FAIL(String(error.message||error));}}
