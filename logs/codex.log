    scorecard.classList.add('show');
  }

  function renderChannels() {
    channelsEl.innerHTML = channelNames.map((name) => `<button type="button" role="tab" aria-selected="${name === state.channel}" class="channel ${name === state.channel ? 'active' : ''}" data-channel="${escapeHtml(name)}">${escapeHtml(name)}</button>`).join('');
    channelsEl.querySelectorAll('.channel').forEach((button) => button.addEventListener('click', () => { state.channel = button.dataset.channel; renderChannels(); renderMessage(); }));
  }

  function renderMessage() {
    const play = state.data.plays[state.selected];
    const physical = ['Mailed card', 'Gift/leave-behind'].includes(state.channel);
    advisory.classList.toggle('show', physical);
    recommendation.classList.toggle('show', physical);
    if (physical) {
      $('#recLabel').textContent = state.channel === 'Mailed card' ? 'Format guidance' : 'Appropriateness check';
      $('#recCopy').textContent = state.channel === 'Mailed card' ? 'Handwrite it, keep the envelope plain, and include no manufactured urgency.' : 'Use only a modest, relevant item that complies with the prospect’s policies. The note must carry the value.';
    }
    messageText.textContent = play.scripts[state.channel];
  }

  function renderAll() {
    const play = state.data.plays[state.selected];
    renderReasons(); renderScore(); renderChannels(); renderMessage();
    $('#scriptByline').textContent = `Written from you to ${state.input.prospectName || state.input.company || 'the prospect'}.`;
    playPlan.innerHTML = `<div class="plan-card"><strong>Why they may care now</strong><p>${escapeHtml(play.whyNow)}</p></div><div class="plan-card"><strong>Value to bring or create</strong><p>${escapeHtml(play.valueToBring)}</p></div><div class="plan-card"><strong>Recommended primary channel</strong><p>${escapeHtml(play.primaryChannel)}</p></div><div class="plan-card"><strong>2–3 touch sequence</strong><ol>${play.sequence.map((step) => `<li>${escapeHtml(step)}</li>`).join('')}</ol></div>`;
    composer.classList.add('show');
    $('#actionBar').classList.add('show');
  }

  const withTimeout = (promise, ms, message) => Promise.race([promise, new Promise((_, reject) => setTimeout(() => reject(new Error(message)), ms))]);
  const safeFilename = (value) => asText(value, 'outreach-plan').normalize('NFKD').replace(/[^a-z0-9]+/gi, '-').replace(/^-+|-+$/g, '').slice(0, 70) || 'outreach-plan';
  async function buildPdf(input = state.input, data = state.data) {
    if (!window.PDFLib || !window.PDFLib.PDFDocument) throw new Error('PDF creation is unavailable because the local PDF library did not load.');
    const { PDFDocument, StandardFonts, rgb } = window.PDFLib;
    const doc = await PDFDocument.create();
    const regular = await doc.embedFont(StandardFonts.Helvetica);
    const bold = await doc.embedFont(StandardFonts.HelveticaBold);
    let logo = null;
    try { const response = await fetch('Airstrike_Marketing_logo_design_300_DPI.png'); if (response.ok) logo = await doc.embedPng(await response.arrayBuffer()); } catch (_) {}
    const W = 612, H = 792, margin = 48, bottom = 48, ink = rgb(.08,.16,.28), gold = rgb(.78,.61,.35), muted = rgb(.36,.41,.48);
    let page, y;
    const pages = [];
    function newPage() { page = doc.addPage([W, H]); pages.push(page); y = H - 48; if (logo) { const dims = logo.scaleToFit(130, 42); page.drawImage(logo, { x: margin, y: y - dims.height, width: dims.width, height: dims.height }); y -= Math.max(50, dims.height + 12); } else { page.drawText('AIRSTRIKE MARKETING', { x: margin, y: y - 12, size: 11, font: bold, color: ink }); y -= 34; } }
    function lines(text, font, size, maxWidth) { const words = asText(text, '—').replace(/\r/g, '').split(/\s+/); const out = []; let line = ''; words.forEach((word) => { const candidate = line ? `${line} ${word}` : word; if (font.widthOfTextAtSize(candidate, size) <= maxWidth) line = candidate; else { if (line) out.push(line); let chunk = word; while (font.widthOfTextAtSize(chunk, size) > maxWidth && chunk.length > 1) { let cut = chunk.length - 1; while (cut > 1 && font.widthOfTextAtSize(chunk.slice(0, cut), size) > maxWidth) cut--; out.push(chunk.slice(0, cut)); chunk = chunk.slice(cut); } line = chunk; } }); if (line) out.push(line); return out; }
    function ensure(height) { if (!page || y - height < bottom) newPage(); }
    function textBlock(text, opts = {}) { const size = opts.size || 10, leading = opts.leading || size * 1.35, font = opts.bold ? bold : regular, color = opts.color || ink, indent = opts.indent || 0; const all = asText(text, '—').split('\n'); all.forEach((paragraph, pi) => { const wrapped = lines(paragraph || ' ', font, size, W - margin * 2 - indent); wrapped.forEach((line) => { ensure(leading + 2); page.drawText(line, { x: margin + indent, y: y - size, size, font, color }); y -= leading; }); if (pi < all.length - 1) y -= 3; }); if (opts.after) y -= opts.after; }
    function heading(text, size = 15) { ensure(size + 14); textBlock(text, { size, bold: true, color: gold, leading: size * 1.2, after: 5 }); }
    newPage();
    textBlock('REASON TO REACH OUT', { size: 9, bold: true, color: gold, after: 5 });
    textBlock(`${input.company || 'Prospect'} outreach plan`, { size: 24, bold: true, leading: 28, after: 10 });
    textBlock(`Generated ${new Date().toLocaleDateString()}  •  Prospect: ${input.prospectName || 'Not provided'}  •  Company: ${input.company || 'Not provided'}`, { size: 9, color: muted, after: 3 });
    textBlock(`Relationship: ${input.relationship || 'Not provided'}  •  Stage: ${input.stage || 'Not provided'}`, { size: 9, color: muted, after: 15 });
    heading('Strategic diagnosis'); textBlock(data.diagnosis, { after: 10 });
    heading('Assumptions'); textBlock(data.assumptions.length ? data.assumptions.map((a) => `• ${a}`).join('\n') : 'None stated.', { after: 12 });
    data.plays.forEach((play) => {
      heading(`${play.rank}. ${play.title} — ${play.score}/10`, 17);
      textBlock(`ANGLE  ${play.strategicAngle}`, { after: 5 });
      textBlock(`WHY NOW  ${play.whyNow}`, { after: 5 });
      textBlock(`VALUE TO BRING / CREATE  ${play.valueToBring}`, { after: 5 });
      textBlock(`PRIMARY CHANNEL  ${play.primaryChannel}`, { after: 5 });
      textBlock(`SEQUENCE\n${play.sequence.map((step, i) => `${i + 1}. ${step}`).join('\n')}`, { after: 8 });
      heading('Prospect-facing scripts', 12);
      channelNames.forEach((channel) => { textBlock(channel.toUpperCase(), { size: 8, bold: true, color: muted, after: 2 }); textBlock(play.scripts[channel], { size: 9, after: 7, indent: 8 }); });
      y -= 8;
    });
    pages.forEach((p, index) => { p.drawLine({ start: { x: margin, y: 31 }, end: { x: W - margin, y: 31 }, thickness: .5, color: gold }); p.drawText(`Airstrike Marketing • Reason to Reach Out`, { x: margin, y: 18, size: 7, font: regular, color: muted }); const label = `${index + 1} / ${pages.length}`; p.drawText(label, { x: W - margin - regular.widthOfTextAtSize(label, 7), y: 18, size: 7, font: regular, color: muted }); });
    return doc.save();
  }
  function downloadBytes(bytes, filename, type = 'application/pdf') { const blob = bytes instanceof Blob ? bytes : new Blob([bytes], { type }); const url = URL.createObjectURL(blob); const a = document.createElement('a'); a.href = url; a.download = filename; document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(url), 2000); return blob; }
  async function pdfAction(button, input, data) {
    const original = button.textContent; button.disabled = true; button.textContent = 'Preparing…'; $('#actionNote').classList.remove('quiet-error');
    try {
      const bytes = await withTimeout(buildPdf(input, data), 30000, 'PDF creation timed out. Please try again.');
      downloadBytes(bytes, `${safeFilename(input.company)}-reason-to-reach-out.pdf`);
    } catch (error) { if (error && error.name !== 'AbortError') { const message = asText(error.message, 'Could not create the PDF.'); $('#actionNote').textContent = message; $('#actionNote').classList.add('quiet-error'); } throw error; }
    finally { button.disabled = false; button.textContent = original; }
  }

  function openModal(overlay) { state.lastFocus = document.activeElement; overlay.classList.add('show'); overlay.setAttribute('aria-hidden', 'false'); document.body.classList.add('modal-open'); const first = overlay.querySelector('input,button'); if (first) first.focus(); }
  function closeModal(overlay) { overlay.classList.remove('show'); overlay.setAttribute('aria-hidden', 'true'); document.body.classList.remove('modal-open'); if (state.lastFocus && state.lastFocus.focus) state.lastFocus.focus(); }
  function modalKeys(event) { const overlay = event.currentTarget; if (event.key === 'Escape') closeModal(overlay); if (event.key === 'Tab') { const focusable = [...overlay.querySelectorAll('button:not([disabled]),input:not([disabled])')]; if (!focusable.length) return; const first = focusable[0], last = focusable[focusable.length - 1]; if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); } else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); } } }
  function restoreLatest(latest) { state.planId = latest.id || makeId(); state.input = latest.input; state.data = latest.data; state.selected = Math.min(latest.selected || 0, 3); state.offline = !!latest.offline; state.channel = state.data.plays[state.selected].primaryChannel; Object.entries({ relationship:'relationship',stage:'stage',company:'company',prospectName:'prospectName',prospectRole:'prospectRole',situation:'situation',priority:'priority',lastContact:'lastContact',trigger:'trigger',desiredNextStep:'nextStep' }).forEach(([key,id]) => { $(`#${id}`).value = state.input[key] || ''; }); $('#diagnosisTitle').textContent = state.offline ? 'Offline strategy: useful, but limited.' : 'Relevance before repetition.'; $('#diagnosisCopy').textContent = state.data.diagnosis; $('#diagnosisBadge').textContent = state.offline ? 'AI unavailable' : state.input.relationship; empty.style.display = 'none'; results.classList.add('show'); renderAll(); saveLatest(); }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    state.input = collectInput(); state.planId = makeId();
    submitButton.disabled = true;
    submitButton.textContent = 'Building prospect-centered plays…';
    setStatus('loading', 'The strategist is weighing four distinct ways to earn the prospect’s attention…');
    const loadingStatusTimers = [
      setTimeout(() => setStatus('loading', 'The strategist is still building four complete plays and their channel scripts…'), 30000),
      setTimeout(() => setStatus('loading', 'Still working—this detailed request can take up to 3 minutes…'), 90000)
    ];
    try {
      state.data = await generate(state.input);
      state.offline = false;
      clearStatus();
      state.selected = 0; state.channel = state.data.plays[0].primaryChannel;
      $('#diagnosisTitle').textContent = 'Relevance before repetition.';
      $('#diagnosisCopy').textContent = state.data.diagnosis;
      $('#diagnosisBadge').textContent = state.input.relationship;
      empty.style.display = 'none'; results.classList.add('show'); renderAll();
      saveLatest();
      if (window.innerWidth < 901) results.scrollIntoView({ behavior: 'smooth', block: 'start' });
      if (typeof window.ASOS_COMPLETE === 'function') window.ASOS_COMPLETE({ input: state.input, ...state.data }, 'json');
    } catch (error) {
      state.data = fallback(state.input); state.selected = 0; state.channel = state.data.plays[0].primaryChannel;
      state.offline = true;
      setStatus('fallback', `AI unavailable (${error && error.name === 'AbortError' ? 'request timed out after 3 minutes' : asText(error.message, 'service error')}). Showing clearly labeled offline plays based only on your inputs. You can use these now or try again.`);
      $('#diagnosisTitle').textContent = 'Offline strategy: useful, but limited.';
      $('#diagnosisCopy').textContent = state.data.diagnosis;
      $('#diagnosisBadge').textContent = 'AI unavailable';
      empty.style.display = 'none'; results.classList.add('show'); renderAll();
      saveLatest();
      if (typeof window.ASOS_FAIL === 'function' && window.ASOS_RUN) window.ASOS_FAIL(asText(error.message, 'AI generation failed'));
    } finally {
      loadingStatusTimers.forEach(clearTimeout);
      submitButton.disabled = false;
      submitButton.textContent = 'Build four outreach plays';
    }
  });

  $('#copyButton').addEventListener('click', async () => {
    const button = $('#copyButton');
    if (!navigator.clipboard || typeof navigator.clipboard.writeText !== 'function' || !window.isSecureContext) { button.textContent = 'Select and copy'; return; }
    try { await navigator.clipboard.writeText(messageText.textContent); button.textContent = 'Copied'; setTimeout(() => { button.textContent = 'Copy wording'; }, 1500); }
    catch (_) { button.textContent = 'Select and copy'; }
  });

  function openCapture(intent) { state.captureIntent = intent; $('#captureTitle').textContent = intent === 'download' ? 'Download your plan' : 'Email your plan'; $('#confirmCapture').textContent = intent === 'download' ? 'Download PDF' : 'Email my PDF'; $('#captureMessage').textContent = ''; $('#actionNote').textContent = 'PDFs are made on this device. Your prospect details are not uploaded for PDF creation.'; $('#actionNote').classList.remove('quiet-error'); $('#nurtureConsent').checked = false; openModal($('#captureOverlay')); }
  $('#downloadPdf').addEventListener('click', () => openCapture('download'));
  $('#emailPdf').addEventListener('click', () => openCapture('email requested'));
  const captureOverlay = $('#captureOverlay');
  captureOverlay.addEventListener('keydown', modalKeys); captureOverlay.addEventListener('mousedown', (event) => { if (event.target === captureOverlay) closeModal(captureOverlay); }); captureOverlay.querySelectorAll('.close-modal').forEach((button) => button.addEventListener('click', () => closeModal(captureOverlay)));

  $('#contactForm').addEventListener('submit', async (event) => {
    event.preventDefault(); const contactForm = event.currentTarget; if (!contactForm.reportValidity()) return;
    const button = $('#confirmCapture'); const original = button.textContent; button.disabled = true; button.textContent = 'Preparing…';
    try {
      const store = readStore();
      const consent = $('#nurtureConsent').checked; const now = new Date().toISOString();
      const lead = { firstName: asText($('#ownerFirstName').value), email: asText($('#ownerEmail').value).toLowerCase(), company: asText($('#ownerCompany').value), source: 'Reason to Reach Out Demo', action: state.captureIntent, nurtureConsent: consent, consentTimestamp: consent ? now : '', capturedTimestamp: now, relationship: state.input.relationship, stage: state.input.stage, selectedPlayTitle: state.data.plays[state.selected].title, planId: state.planId };
      const duplicate = store.leads.findIndex((item) => asText(item.email).toLowerCase() === lead.email && item.planId === lead.planId && item.action === lead.action);
      if (duplicate >= 0) store.leads[duplicate] = lead; else store.leads.push(lead);
      writeStore(store);
      await pdfAction(button, state.input, state.data);
      if (state.captureIntent === 'email requested') $('#captureMessage').textContent = 'Email delivery is not connected yet. Your PDF was downloaded instead.';
      else closeModal(captureOverlay);
    } catch (error) { $('#captureMessage').textContent = asText(error.message, 'Could not prepare this plan.'); }
    finally { button.disabled = false; button.textContent = original; }
  });

  function csvCell(value) { return `"${String(value == null ? '' : value).replace(/"/g, '""')}"`; }
  $('#exportCsv').addEventListener('click', () => {
    const button = $('#exportCsv'); button.disabled = true;
    try {
      const leads = readStore().leads; if (!leads.length) throw new Error('No locally captured user records to export yet.');
      const headers = ['first name','email','company','source','action','nurture consent','consent timestamp','captured timestamp','relationship','stage','selected play title','plan ID'];
      const rows = leads.map((l) => [l.firstName,l.email,l.company,l.source,l.action,l.nurtureConsent ? 'true' : 'false',l.consentTimestamp || '',l.capturedTimestamp,l.relationship,l.stage,l.selectedPlayTitle,l.planId]);
      const csv = `\uFEFF${[headers, ...rows].map((row) => row.map(csvCell).join(',')).join('\r\n')}`; downloadBytes(new Blob([csv], { type: 'text/csv;charset=utf-8' }), 'reason-to-reach-out-ghl-leads.csv', 'text/csv'); $('#ownerToolsMessage').textContent = `Exported ${leads.length} local record${leads.length === 1 ? '' : 's'} for manual GoHighLevel import.`;
    } catch (error) { $('#ownerToolsMessage').textContent = asText(error.message, 'Could not export CSV.'); }
    finally { button.disabled = false; }
  });

  let draftTimer;
  form.addEventListener('input', () => { clearTimeout(draftTimer); draftTimer = setTimeout(saveDraft, 250); });

  function restoreLocal() {
    const store = readStore(); const source = store.latest && store.latest.data ? store.latest.input : store.draft;
    if (source) Object.entries({ relationship:'relationship',stage:'stage',company:'company',prospectName:'prospectName',prospectRole:'prospectRole',situation:'situation',priority:'priority',lastContact:'lastContact',trigger:'trigger',desiredNextStep:'nextStep' }).forEach(([key,id]) => { if (source[key] != null) $(`#${id}`).value = source[key]; });
    if (store.latest && store.latest.data) restoreLatest(store.latest);
  }

  function applyRun(run) {
    try {
      const data = typeof run === 'string' ? JSON.parse(run) : run;
      if (typeof data === 'string') $('#situation').value = data;
      else if (data) {
        const fields = { relationship: 'relationship', stage: 'stage', company: 'company', prospectName: 'prospectName', prospectRole: 'prospectRole', situation: 'situation', priority: 'priority', lastContact: 'lastContact', trigger: 'trigger', nextStep: 'nextStep', desiredNextStep: 'nextStep' };
        Object.keys(fields).forEach((key) => { if (data[key] != null && $( `#${fields[key]}` )) $( `#${fields[key]}` ).value = data[key]; });
        if (!data.situation && data.text) $('#situation').value = data.text;
      }
