+import { execFile } from 'node:child_process';
+
+export function buildPrompt(input) {
+  return `You are a seasoned B2B sales strategist. Address the app user as "you" in reasoning. Write every prospect-facing script from the app user, signed ${input.firstName}. Never mention Mike or Larkin. Use only verified input; never invent facts, proof, urgency, news, metrics, or existing assets. Create exactly four distinct, ranked, prospect-centered plays. Each play must include title, strategicAngle, whyNow, valueToBring, primaryChannel, a 2-3 step sequence, rationale, scripts for email, callOpener, voicemail, text, linkedIn, mailedCard, and giftLeaveBehind, and rubric with relevance, newness, value, decisionHelp, prospectBenefit each as integers 0..2. Do not provide rubric total. Return strict JSON only with diagnosis, assumptions, and plays.\n\nVERIFIED INPUT:\n${JSON.stringify(input, null, 2)}`;
+}
+
+export function createHermesGenerator({ command = process.env.HERMES_CLI || 'hermes' } = {}) {
+  return (input, { timeoutMs = 30_000 } = {}) => new Promise((resolve, reject) => {
+    execFile(command, ['chat', '--json', '--prompt', buildPrompt(input)], { timeout: timeoutMs, maxBuffer: 2_000_000, env: process.env }, (error, stdout) => {
+      if (error) return reject(error);
+      try {
+        const raw = JSON.parse(stdout);
+        const value = raw.response ?? raw.output ?? raw.content ?? raw;
+        resolve(typeof value === 'string' ? JSON.parse(value.replace(/^```json\s*|\s*```$/g, '')) : value);
+      } catch (parseError) { reject(new Error(`Hermes returned invalid JSON: ${parseError.message}`)); }
+    });
+  });
+}
