+};
+
+async function withServer(options, run) {
+  const server = createApp(options);
+  server.listen(0, '127.0.0.1');
+  await once(server, 'listening');
+  try { await run(`http://127.0.0.1:${server.address().port}`); }
+  finally { await new Promise((resolve) => server.close(resolve)); }
+}
+
+test('generate validation is strict and requires firstName', () => {
+  assert.equal(validateGenerate(validGenerate).firstName, 'Avery');
+  assert.throws(() => validateGenerate({ ...validGenerate, firstName: '' }), /firstName/);
+  assert.throws(() => validateGenerate({ ...validGenerate, surprise: true }), /unknown/i);
+});
+
+test('event validation rejects forbidden and arbitrary fields', () => {
+  const base = { type: 'channel_viewed', sessionId: 'session-12345678', timestamp: new Date().toISOString(), source: 'newsletter', selectedPlay: 'Decision map', channel: 'Email' };
+  assert.equal(validateEvent(base).type, 'channel_viewed');
+  for (const key of ['prospectName', 'company', 'prospectCompany', 'situation', 'priority', 'trigger', 'desiredNextStep', 'scripts', 'plan']) {
+    assert.throws(() => validateEvent({ ...base, [key]: 'secret' }), /forbidden|unknown/i, key);
+  }
+  assert.throws(() => validateEvent({ ...base, arbitrary: 1 }), /unknown/i);
+  assert.throws(() => validateEvent({ ...base, type: 'anything' }), /type/i);
+});
+
+test('CORS permits production and loopback origins and rejects others', async () => {
+  await withServer({ generator: async () => ({}) , ghl: { record: async () => ({}) } }, async (base) => {
+    for (const origin of ['https://reasontoreachout.com', 'https://www.reasontoreachout.com', 'http://localhost:5173', 'http://127.0.0.1:8080']) {
+      const response = await fetch(`${base}/api/rtro/generate`, { method: 'OPTIONS', headers: { Origin: origin, 'Access-Control-Request-Method': 'POST' } });
+      assert.equal(response.status, 204);
+      assert.equal(response.headers.get('access-control-allow-origin'), origin);
+    }
+    const denied = await fetch(`${base}/api/rtro/generate`, { method: 'OPTIONS', headers: { Origin: 'https://evil.example' } });
+    assert.equal(denied.status, 403);
+    assert.equal(denied.headers.get('access-control-allow-origin'), null);
+  });
+});
+
+test('generation rate limit is 10 per IP per hour and honors CF-Connecting-IP', async () => {
+  const rubric = { relevance: 2, newness: 2, value: 2, decisionHelp: 2, prospectBenefit: 2 };
+  const play = { title:'x', strategicAngle:'x', whyNow:'x', valueToBring:'x', primaryChannel:'Email', sequence:['x'], rationale:'x', rubric, scripts:{ email:'x', callOpener:'x', voicemail:'x', text:'x', linkedIn:'x', mailedCard:'x', giftLeaveBehind:'x' } };
+  await withServer({ generator: async () => ({ diagnosis:'x', assumptions:[], plays:[play,play,play,play] }), ghl: { record: async () => ({}) } }, async (base) => {
+    for (let i = 0; i < 10; i++) {
+      const response = await fetch(`${base}/api/rtro/generate`, { method:'POST', headers:{ 'content-type':'application/json', origin:'http://localhost:3000', 'CF-Connecting-IP':'203.0.113.9' }, body:JSON.stringify(validGenerate) });
+      assert.equal(response.status, 200);
+    }
+    const limited = await fetch(`${base}/api/rtro/generate`, { method:'POST', headers:{ 'content-type':'application/json', origin:'http://localhost:3000', 'CF-Connecting-IP':'203.0.113.9' }, body:JSON.stringify(validGenerate) });
+    assert.equal(limited.status, 429);
+    assert.match((await limited.json()).error, /too many/i);
+  });
+});
+
+test('event rate limit is 60 per IP per hour', async () => {
+  await withServer({ generator: async () => ({}), ghl: { record: async () => ({ ok:true }) } }, async (base) => {
+    const event = { type:'plan_generated', sessionId:'session-12345678', timestamp:new Date().toISOString(), source:'direct', relationship:'Stalled deal', stage:'Proposal', channel:'Email', selectedPlay:'Decision map' };
+    for (let i=0;i<60;i++) assert.equal((await fetch(`${base}/api/rtro/event`, { method:'POST', headers:{'content-type':'application/json',origin:'http://127.0.0.1:4000','CF-Connecting-IP':'198.51.100.4'}, body:JSON.stringify(event) })).status, 202);
+    assert.equal((await fetch(`${base}/api/rtro/event`, { method:'POST', headers:{'content-type':'application/json',origin:'http://127.0.0.1:4000','CF-Connecting-IP':'198.51.100.4'}, body:JSON.stringify(event) })).status, 429);
+  });
+});
