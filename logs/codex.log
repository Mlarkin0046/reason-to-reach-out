+  async function createPdf(){const {PDFDocument,StandardFonts,rgb}=window.PDFLib;const doc=await PDFDocument.create(),font=await doc.embedFont(StandardFonts.Helvetica),bold=await doc.embedFont(StandardFonts.HelveticaBold);const add=(title,lines)=>{const p=doc.addPage([612,792]);p.drawText(title,{x:44,y:744,size:20,font:bold,color:rgb(.08,.16,.28)});let y=708;for(const line of lines){for(const chunk of String(line).match(/.{1,88}(?:\s|$)/g)||['']){p.drawText(chunk.trim(),{x:44,y,size:9,font});y-=13;if(y<45)break;}y-=6;}return p;};add(`${state.input.company} — Reason to Reach Out`,[state.data.diagnosis,...state.data.plays.flatMap(p=>[`${p.rank}. ${p.title} — ${p.rubric.total}/10`,`Relevance ${p.rubric.relevance}/2 · Newness ${p.rubric.newness}/2 · Value ${p.rubric.value}/2 · Decision help ${p.rubric.decisionHelp}/2 · Prospect benefit ${p.rubric.prospectBenefit}/2`,p.strategicAngle,p.whyNow,p.valueToBring,...CHANNELS.map(c=>`${c}: ${p.scripts[c]}`)])]);const selected=state.data.plays[state.selected],physical=['Mailed card','Gift/leave-behind'].includes(selected.primaryChannel);add('Talk to Mike — Airstrike Marketing',[physical?'Want help making the physical follow-up memorable? Talk to Mike about a thoughtful card, modest gift, or leave-behind that fits the relationship.':'Want another set of eyes? Talk to Mike about sharpening the reason, sequence, or wording.',`Phone: ${PHONE_DISPLAY}`,`Email: ${CONTACT_EMAIL}`,`Book: ${BOOKING_URL}`,...(physical?[`Video: ${VIDEO_URL}`,`Mailbox Power: ${MAILBOX_URL}`,'Recommendations only. Review the prospect’s gift and vendor policies before sending anything.']:[])]);const bytes=await doc.save();const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([bytes],{type:'application/pdf'}));a.download='reason-to-reach-out.pdf';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);}
