    .primary{width:100%;border:0;border-radius:12px;background:var(--gold);color:#10213c;padding:15px 18px;font-weight:900;box-shadow:0 10px 25px rgba(0,0,0,.18);transition:transform .2s,filter .2s}
    .primary:hover{transform:translateY(-2px);filter:brightness(1.05)}
    .primary:focus-visible,.channel:focus-visible,.reason-card:focus-visible,.copy:focus-visible{outline:3px solid #90b7ff;outline-offset:3px}
    .safe-note{display:flex;gap:9px;align-items:flex-start;margin-top:15px;color:#aeb8c8;font-size:.74rem}
    .safe-dot{width:7px;height:7px;flex:0 0 7px;background:var(--gold);border-radius:50%;margin-top:5px}
    .result-panel{padding:42px 42px 48px;background:linear-gradient(180deg,#fff 0,#fdfcf9 100%)}
    .empty{height:100%;min-height:600px;display:grid;place-content:center;text-align:center;max-width:560px;margin:auto}
    .empty-mark{width:68px;height:68px;border-radius:50%;border:1px solid var(--gold);display:grid;place-items:center;margin:0 auto 22px;font-family:Georgia,serif;font-size:1.5rem;color:var(--gold)}
    .empty h2{font-size:2.5rem;margin-bottom:12px}
    .empty p{color:var(--muted);margin:0}
    .results{display:none}
    .results.show{display:block}
    .diagnosis{display:flex;justify-content:space-between;gap:24px;border-bottom:1px solid var(--line);padding-bottom:26px;margin-bottom:28px}
    .diagnosis h2{font-size:2.4rem;margin:7px 0 8px}
    .diagnosis p{color:var(--muted);margin:0;max-width:680px}
    .diagnosis-badge{align-self:flex-start;white-space:nowrap;border:1px solid var(--gold);border-radius:999px;color:#87602b;background:#fffaf2;padding:8px 13px;font-size:.72rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}
    .section-label{font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;font-weight:900;color:var(--muted);margin-bottom:12px}
    .reasons{display:grid;gap:13px}
    .reason-card{display:grid;grid-template-columns:62px 1fr auto;gap:16px;align-items:center;padding:18px;border:1px solid var(--line);border-radius:15px;background:#fff;text-align:left;color:inherit;transition:.2s;width:100%}
    .reason-card:hover{transform:translateY(-1px);border-color:#c7a06b;box-shadow:0 10px 25px rgba(21,41,71,.08)}
    .reason-card.active{border-color:var(--gold);box-shadow:0 0 0 2px rgba(199,155,89,.18)}
    .score{width:54px;height:54px;border-radius:50%;display:grid;place-content:center;background:var(--ink);color:#fff;font-weight:900}
    .score span{font-size:.65rem;font-weight:500;color:#c8d1df;text-align:center;margin-top:-3px}
    .reason-title{font-family:Georgia,serif;font-size:1.18rem;margin-bottom:3px}
    .reason-why{font-size:.84rem;color:var(--muted)}
    .reason-meta{display:block;margin-top:7px;font-size:.73rem;font-weight:800;color:#87602b;text-transform:uppercase;letter-spacing:.06em}
    .arrow{color:var(--gold);font-size:1.4rem}
    .scorecard{display:none;margin:12px 0 28px;border:1px solid var(--line);border-radius:14px;padding:16px;background:#faf9f6}
    .scorecard.show{display:block}
    .score-row{display:grid;grid-template-columns:1fr 66px;gap:15px;align-items:center;margin:7px 0;font-size:.8rem}
    .dots{display:flex;justify-content:flex-end;gap:4px}
    .dot{width:10px;height:10px;border-radius:50%;background:#d6dbe1}
    .dot.on{background:var(--gold)}
    .composer{display:none;border-top:1px solid var(--line);padding-top:28px}
    .composer.show{display:block}
    .composer h3{font-size:2rem;margin-bottom:7px}
    .composer-sub{color:var(--muted);font-size:.9rem;margin:0 0 18px}
    .plan{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:16px 0 22px}
    .plan-card{border:1px solid var(--line);border-radius:13px;padding:15px;background:#faf9f6}
    .plan-card strong{display:block;font-size:.72rem;text-transform:uppercase;letter-spacing:.09em;margin-bottom:5px;color:#87602b}
    .plan-card p,.plan-card ol{margin:0;color:var(--ink-2);font-size:.86rem}
    .plan-card ol{padding-left:19px}.plan-card li+li{margin-top:5px}
    .channels{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}
    .channel{border:1px solid var(--line);border-radius:999px;padding:8px 12px;background:#fff;color:var(--ink);font-size:.78rem;font-weight:800}
    .channel.active{background:var(--ink);border-color:var(--ink);color:#fff}
    .advisory{display:none;gap:10px;background:#f7efe3;border:1px solid #e2c79e;color:#725226;padding:12px 14px;border-radius:12px;margin-bottom:14px;font-size:.82rem}
    .advisory.show{display:flex}
    .message-box{position:relative;border:1px solid var(--line);border-radius:15px;background:#fff;padding:20px 20px 58px;min-height:160px;white-space:pre-wrap;font-size:.94rem;color:#273955}
    .copy{position:absolute;right:12px;bottom:12px;border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:9px;padding:8px 11px;font-size:.75rem;font-weight:800}
    .status{display:none;border-radius:12px;padding:12px 14px;margin:0 0 18px;font-size:.84rem}
    .status.show{display:block}.status.loading{background:#eef3f8;color:var(--ink-2)}.status.error{background:#fff0ee;color:var(--danger);border:1px solid #efc8c4}.status.fallback{background:#fff7e9;color:#725226;border:1px solid #ead2a9}
    .spinner{display:inline-block;width:14px;height:14px;border:2px solid #adbacb;border-top-color:var(--ink);border-radius:50%;vertical-align:-2px;margin-right:8px;animation:spin .8s linear infinite}
    @keyframes spin{to{transform:rotate(360deg)}}
    .primary:disabled{cursor:wait;opacity:.7;transform:none}
    .helper{display:block;margin-top:6px;color:#aeb8c8;font-size:.72rem;line-height:1.35}
    .recommendation{display:none;margin-bottom:14px;border-left:3px solid var(--gold);padding:4px 0 4px 14px}
    .recommendation.show{display:block}
    .recommendation strong{display:block;font-size:.8rem;text-transform:uppercase;letter-spacing:.08em;margin-bottom:3px}
    .recommendation span{color:var(--muted);font-size:.88rem}
    .action-bar{display:none;align-items:center;gap:9px;flex-wrap:wrap;margin:0 0 28px;padding:14px;border:1px solid var(--line);border-radius:15px;background:#f7f4ed}
    .action-bar.show{display:flex}.action-bar>button,.secondary{min-height:44px;border:1px solid var(--ink);border-radius:10px;background:var(--ink);color:#fff;padding:9px 14px;font-weight:800}
    .secondary{background:#fff;color:var(--ink);border-color:var(--line)}.action-bar button:disabled,.secondary:disabled{opacity:.55;cursor:wait}
    .action-bar details{flex-basis:100%;font-size:.76rem;color:var(--muted)}.action-bar summary{cursor:pointer;width:max-content}.owner-tools{display:flex;align-items:center;gap:10px;margin-top:9px}.owner-tools button{min-height:36px;border:1px solid var(--line);border-radius:8px;background:#fff;color:var(--ink);padding:7px 10px;font-size:.75rem;font-weight:800}
    .setup-label{display:block;font-size:.65rem;font-weight:700;opacity:.72;margin-top:2px}
    .action-note{flex-basis:100%;margin:0;color:var(--muted);font-size:.76rem}.quiet-error{color:var(--danger)}
    .privacy-note{margin:18px 0 0;color:var(--muted);font-size:.78rem}
    .overlay{position:fixed;inset:0;z-index:200;display:none;align-items:center;justify-content:center;padding:16px;background:rgba(12,25,44,.62)}.overlay.show{display:flex}
    .modal{width:min(560px,100%);max-height:calc(100vh - 32px);overflow:auto;background:#fff;border-radius:18px;box-shadow:var(--shadow);padding:25px;color:var(--ink)}
    .modal-head{display:flex;align-items:flex-start;justify-content:space-between;gap:15px;margin-bottom:18px}.modal h2{font-size:2rem}.icon-button{min-width:44px;border:1px solid var(--line);border-radius:10px;background:#fff;font-size:1.4rem}
    .modal .field label{color:var(--ink)}.modal input{background:#fff;color:var(--ink);border-color:#b7c0cb}.modal input:focus{border-color:var(--gold)}
    .consent{display:grid;grid-template-columns:24px 1fr;gap:10px;align-items:start;margin:15px 0}.consent input{width:20px;height:20px;margin:2px 0}.consent label{font-size:.86rem;letter-spacing:0;text-transform:none;color:var(--ink);font-weight:500}
    .modal-actions{display:flex;flex-wrap:wrap;gap:9px;align-items:center;margin-top:18px}.modal-actions .primary{width:auto}.modal-copy{color:var(--muted);font-size:.86rem}
    body.modal-open{overflow:hidden}
    .method{padding:95px 0;background:#fff;border-top:1px solid rgba(21,41,71,.08)}
    .method-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:90px}
    .method h2{font-size:clamp(2.7rem,5vw,4.7rem);letter-spacing:-.04em;margin-top:13px}
    .method-copy{display:grid;grid-template-columns:1fr 1fr;gap:18px}
    .method-card{padding:26px;border:1px solid var(--line);border-radius:16px}
    .method-card b{font-family:Georgia,serif;font-size:1.18rem;display:block;margin-bottom:6px}
    .method-card p{color:var(--muted);font-size:.88rem;margin:0}
    footer{padding:35px 0;color:var(--muted);font-size:.78rem}
    .footer-row{display:flex;align-items:center;justify-content:space-between;gap:20px}
    .footer-logo{height:34px;width:auto;border-radius:5px}
    @media(max-width:900px){
      .hero-grid,.method-grid{grid-template-columns:1fr;gap:30px}
      .app{grid-template-columns:1fr}
      .form-panel{padding:30px 24px}
      .result-panel{padding:32px 24px}
      .nav-note{display:none}
      .diagnosis{display:block}.diagnosis-badge{display:inline-block;margin-top:15px}
    }
    @media(max-width:620px){
      .shell{width:min(100% - 24px,1180px)}
      .nav{height:74px}.brand-copy{display:none}.brand-logo{height:40px}
      .hero{padding:46px 0}.hero-grid{margin-top:22px}.hero-copy{font-size:1rem}
      h1{font-size:clamp(3rem,15vw,4.7rem)}
      .app-wrap{padding-top:12px}.app{border-radius:20px}
      .two,.method-copy,.plan{grid-template-columns:1fr}
      .reason-card{grid-template-columns:52px 1fr;padding:14px;gap:12px}.arrow{display:none}.score{width:48px;height:48px}
      .result-panel{padding:28px 16px}.form-panel{padding:28px 18px}
      .empty{min-height:400px}.empty h2{font-size:2rem}
      .footer-row{align-items:flex-start;flex-direction:column}
    }
    @media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
  </style>
</head>
<body>
<a class="skip" href="#app">Skip to the assessment</a>
<header class="shell">
  <nav class="nav" aria-label="Primary">
    <a class="brand" href="#top" aria-label="Reason to Reach Out home">
      <img class="brand-logo" src="Airstrike_Marketing_logo_design_300_DPI.png" alt="Airstrike Marketing logo">
      <span class="brand-copy"><strong>Reason to Reach Out</strong><span>by Airstrike Marketing</span></span>
    </a>
    <span class="nav-note">A human-first sales diagnostic</span>
  </nav>
</header>
<main id="top">
  <section class="hero shell">
    <span class="eyebrow">Stop checking in</span>
    <h1>Give them a reason <em>to care.</em></h1>
    <div class="hero-grid">
      <p class="hero-copy">Describe a real sales opportunity. The diagnostic will identify customer-centered reasons to reconnect, rank their strength, and help you show up with relevance.</p>
      <div class="principle">Your reason for contacting them is not necessarily their reason for wanting to hear from you.</div>
    </div>
  </section>

  <section class="app-wrap shell" id="app" aria-label="Reason to Reach Out assessment">
    <div class="app">
      <form class="form-panel" id="reasonForm">
        <div class="step-kicker">The opportunity</div>
        <h2>What’s happening?</h2>
        <p class="form-intro">Give the strategist enough truth to find a useful reason for the prospect to engage. Don’t include confidential data.</p>
        <div class="two">
          <div class="field">
            <label for="relationship">Your relationship</label>
            <select id="relationship">
              <option>Active opportunity</option><option>Stalled deal</option><option>Existing customer</option><option>Former customer</option><option>Referral source</option><option>Lost opportunity</option>
            </select>
          </div>
          <div class="field">
            <label for="stage">Current sales stage</label>
            <select id="stage">
              <option>Proposal or quote</option><option>Discovery</option><option>Demo</option><option>Decision</option><option>No response</option><option>Not now</option><option>Post-sale</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="company">Company <span aria-hidden="true">*</span></label>
          <input id="company" required autocomplete="organization" placeholder="Example: Acme Manufacturing">
        </div>
        <div class="two">
          <div class="field">
            <label for="prospectName">Prospect name (optional)</label>
            <input id="prospectName" autocomplete="name" placeholder="Example: Jordan Lee">
          </div>
          <div class="field">
            <label for="prospectRole">Prospect role (optional)</label>
            <input id="prospectRole" autocomplete="organization-title" placeholder="Example: VP of Operations">
          </div>
        </div>
        <div class="field">
          <label for="situation">What actually happened?</label>
          <textarea id="situation" required placeholder="They liked the proposal but were concerned about implementation time. We agreed I would follow up after their planning meeting."></textarea>
          <small class="helper">Include objections, commitments, stakeholders, and what you already sent or promised.</small>
        </div>
        <div class="two">
          <div class="field">
            <label for="priority">What matters to them?</label>
            <input id="priority" placeholder="Implementation time, risk, growth">
          </div>
          <div class="field">
            <label for="lastContact">Time since last contact (optional)</label>
            <input id="lastContact" placeholder="Example: 3 weeks">
          </div>
        </div>
        <div class="field">
          <label for="trigger">Useful trigger or new information (optional)</label>
          <textarea id="trigger" placeholder="A deadline, leadership change, internal update, relevant insight, or a resource you can genuinely provide."></textarea>
          <small class="helper">Only include verified facts. The strategist will not invent news, cases, metrics, or assets.</small>
        </div>
        <div class="field">
          <label for="nextStep">What next step do you want?</label>
          <input id="nextStep" placeholder="Example: a 15-minute decision call">
        </div>
        <button class="primary" id="submitButton" type="submit">Build four outreach plays</button>
        <div class="safe-note"><span class="safe-dot"></span><span>Cards and gifts are recommendations only. Nothing is ordered, mailed, or sent.</span></div>
        <div class="safe-note"><span class="safe-dot"></span><span>Your current draft and contact records stay private to this browser and device unless you download or export them.</span></div>
      </form>

      <div class="result-panel" aria-live="polite">
        <div class="status" id="status" role="status"></div>
        <div class="empty" id="emptyState">
          <div class="empty-mark">R</div>
          <h2>The message comes second.</h2>
          <p>First, find a legitimate reason this person should want to hear from you.</p>
(() => {
  'use strict';
  const $ = (selector) => document.querySelector(selector);
  const form = $('#reasonForm');
  const submitButton = $('#submitButton');
  const empty = $('#emptyState');
  const results = $('#results');
  const reasonList = $('#reasonList');
  const scorecard = $('#scorecard');
  const composer = $('#composer');
  const channelsEl = $('#channels');
  const messageText = $('#messageText');
  const statusEl = $('#status');
  const playPlan = $('#playPlan');
  const advisory = $('#advisory');
  const recommendation = $('#recommendation');
  const channelNames = ['Email', 'Call opener', 'Voicemail', 'Text', 'LinkedIn', 'Mailed card', 'Gift/leave-behind'];
  const STORAGE_KEY = 'r2ro_app_data_v1';
  const STORAGE_VERSION = 1;
  const state = { data: null, selected: 0, channel: 'Email', input: {}, offline: false, planId: null, captureIntent: null, lastFocus: null };

  const asText = (value, fallback = '') => String(value == null ? '' : value).trim() || fallback;
  const escapeHtml = (value) => asText(value).replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
  const clampScore = (value) => Math.max(1, Math.min(10, Math.round(Number(value) || 1)));
  const neutralGreeting = (name) => name ? `Hi ${asText(name).split(/\s+/)[0]},` : 'Hello,';
  const blankStore = () => ({ version: STORAGE_VERSION, draft: {}, latest: null, leads: [] });

  function storageAvailable() {
    try { const key = '__r2ro_test__'; localStorage.setItem(key, key); localStorage.removeItem(key); return true; } catch (_) { return false; }
  }
  function readStore() {
    if (!storageAvailable()) return blankStore();
    try {
      const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
      if (!parsed || parsed.version !== STORAGE_VERSION) return blankStore();
      return { version: STORAGE_VERSION, draft: parsed.draft || {}, latest: parsed.latest || null, leads: Array.isArray(parsed.leads) ? parsed.leads : [] };
    } catch (_) { return blankStore(); }
  }
  function writeStore(store) {
    if (!storageAvailable()) throw new Error('Browser storage is unavailable. Download the PDF to keep this plan.');
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify({ version: STORAGE_VERSION, draft: store.draft || {}, latest: store.latest || null, leads: Array.isArray(store.leads) ? store.leads : [] })); }
    catch (_) { throw new Error('Browser storage is full or unavailable. Download the PDF to keep this plan.'); }
  }
  function makeId() {
    try { if (window.crypto && typeof window.crypto.randomUUID === 'function') return window.crypto.randomUUID(); } catch (_) {}
    const random = window.crypto && typeof window.crypto.getRandomValues === 'function' ? (() => { const a = new Uint32Array(2); window.crypto.getRandomValues(a); return `${a[0].toString(36)}${a[1].toString(36)}`; })() : Math.random().toString(36).slice(2);
    return `r2ro-${Date.now().toString(36)}-${random}`;
  }
  function saveDraft() { try { const store = readStore(); store.draft = collectInput(); writeStore(store); } catch (_) {} }
  function saveLatest() { try { const store = readStore(); store.draft = state.input; store.latest = { id: state.planId, input: state.input, data: state.data, selected: state.selected, offline: state.offline, updatedAt: new Date().toISOString() }; writeStore(store); } catch (_) {} }

  function setStatus(kind, message) {
    statusEl.className = `status ${kind} show`;
    statusEl.innerHTML = kind === 'loading' ? `<span class="spinner" aria-hidden="true"></span>${escapeHtml(message)}` : escapeHtml(message);
  }

  function clearStatus() {
    statusEl.className = 'status';
    statusEl.textContent = '';
  }

  function collectInput() {
    return {
      salesperson: 'Mike',
      relationship: $('#relationship').value,
      stage: $('#stage').value,
      company: asText($('#company').value),
      prospectName: asText($('#prospectName').value),
      prospectRole: asText($('#prospectRole').value),
      situation: asText($('#situation').value),
      priority: asText($('#priority').value),
      lastContact: asText($('#lastContact').value),
      trigger: asText($('#trigger').value),
      desiredNextStep: asText($('#nextStep').value)
    };
  }

  function promptFor(input) {
    const schema = {
      diagnosis: '2-3 sentence strategic diagnosis grounded only in the input',
      assumptions: ['only necessary, explicitly labeled assumptions; empty array if none'],
      plays: [{
        rank: 1,
        title: 'short distinct play name',
        strategicAngle: 'specific strategic angle',
        whyNow: 'why this prospect could care now',
        valueToBring: 'something Mike can genuinely bring or create; label as to-create if it does not yet exist',
        primaryChannel: 'one of: Email, Call opener, Voicemail, Text, LinkedIn, Mailed card, Gift/leave-behind',
        sequence: ['touch 1', 'touch 2', 'touch 3 (optional)'],
        score: 8,
        rationale: 'why the score is deserved and what limits it',
        scripts: {
          email: 'complete concise email including subject line',
          callOpener: 'natural opening words',
          voicemail: 'complete short voicemail',
          text: 'complete short text',
          linkedIn: 'complete LinkedIn message',
          mailedCard: 'complete handwritten-card copy',
          giftLeaveBehind: 'complete note accompanying an appropriate item; never claim it is enclosed unless the play proposes Mike create/obtain it'
        }
      }]
    };
    return [
      { role: 'system', content: `You are a seasoned B2B sales strategist. Create genuinely useful, prospect-centered outreach plays, not paraphrases of the user's fields. Every script is FROM Mike, the salesperson, TO the named prospect at the company. Mike uses first person (I/we) and addresses the prospect in second person (you/your). Never coach Mike inside a script and never address the app user. Keep scripts concise, natural, specific, low-pressure, and channel-appropriate. Acknowledge uncertainty. Never invent facts, news, customer cases, metrics, quotes, outcomes, research, or existing assets. If suggesting a new resource, explicitly say Mike should create it. If the prospect name is unknown, use the neutral greeting “Hello,” and do not guess a name. Produce exactly four meaningfully different plays ranked strongest to weakest. Prefer relevance and useful decision help over gimmicks. Gifts must be modest, appropriate, and optional. Return strict JSON only—no markdown or commentary—matching this schema: ${JSON.stringify(schema)}` },
      { role: 'user', content: `Build outreach plays from this verified situation. Treat blank fields as unknown, not permission to invent.\n${JSON.stringify(input, null, 2)}` }
    ];
  }

  function parseJsonResponse(raw) {
    let value = raw;
    if (value && typeof value === 'object' && !Array.isArray(value)) {
      const data = value.data;
      const dataChoice = data && Array.isArray(data.choices) ? data.choices[0] : null;
      const directChoice = Array.isArray(value.choices) ? value.choices[0] : null;
      value = data?.text
        ?? dataChoice?.message?.content
        ?? directChoice?.message?.content
        ?? value.output
        ?? value.response
        ?? value.content
        ?? value.text
        ?? value.message
        ?? value;
      if (value && typeof value === 'object' && typeof value.content === 'string') value = value.content;
    }
    if (typeof value === 'object') return value;
    const text = asText(value).replace(/^\s*```(?:json)?\s*/i, '').replace(/\s*```\s*$/i, '');
    try { return JSON.parse(text); } catch (_) {
      const start = text.indexOf('{');
      const end = text.lastIndexOf('}');
      if (start >= 0 && end > start) return JSON.parse(text.slice(start, end + 1));
      throw new Error('The strategist returned an unreadable response.');
    }
  }

  function normalize(payload) {
    if (!payload || !Array.isArray(payload.plays) || payload.plays.length < 4) throw new Error('The strategist did not return four complete plays.');
    const plays = payload.plays.slice(0, 4).map((play, index) => {
      const scripts = play.scripts || {};
      const normalizedScripts = {
        'Email': asText(scripts.email),
        'Call opener': asText(scripts.callOpener || scripts.call),
        'Voicemail': asText(scripts.voicemail),
        'Text': asText(scripts.text),
        'LinkedIn': asText(scripts.linkedIn || scripts.linkedin),
        'Mailed card': asText(scripts.mailedCard || scripts.card),
        'Gift/leave-behind': asText(scripts.giftLeaveBehind || scripts.gift)
      };
      if (Object.values(normalizedScripts).some((script) => !script)) throw new Error(`Play ${index + 1} is missing a channel script.`);
      return {
        rank: index + 1,
        title: asText(play.title, `Play ${index + 1}`),
        strategicAngle: asText(play.strategicAngle || play.angle),
        whyNow: asText(play.whyNow || play.whyProspectCares),
        valueToBring: asText(play.valueToBring || play.asset),
        primaryChannel: channelNames.includes(play.primaryChannel) ? play.primaryChannel : 'Email',
        sequence: (Array.isArray(play.sequence) ? play.sequence : []).slice(0, 3).map((item) => asText(item)).filter(Boolean),
        score: clampScore(play.score ?? play.qualityScore),
        rationale: asText(play.rationale || play.scoreRationale),
        scripts: normalizedScripts
      };
    });
    return { diagnosis: asText(payload.diagnosis, 'The next contact needs to earn attention by bringing useful new value.'), assumptions: Array.isArray(payload.assumptions) ? payload.assumptions.map((a) => asText(a)).filter(Boolean) : [], plays };
  }

  function fallback(input) {
    const name = input.prospectName;
    const hello = neutralGreeting(name);
    const company = input.company || 'your organization';
    const priority = input.priority || 'the priorities behind this decision';
    const next = input.desiredNextStep || 'a brief conversation';
    const elapsed = input.lastContact ? ` after ${input.lastContact}` : '';
    const trigger = asText(input.trigger).replace(/[.!?]+$/, '');
    const data = [
      ['Decision-friction map', 'Turn the known concern into a short decision aid instead of another follow-up.', `A clearer way to evaluate ${priority} can reduce work and uncertainty.`, `Create a one-page decision-friction map using only the questions and concerns already shared.`, 'Email'],
      ['Assumption-check conversation', 'Name what remains unknown and invite a correction before proposing another step.', 'Correcting a mistaken assumption is easier than responding to a status request.', 'Prepare three concise assumptions about the decision process and ask the prospect to correct them.', 'Call opener'],
      ['Smallest useful next step', `Reduce the requested commitment while keeping momentum toward ${next}.`, 'A bounded, low-effort step can be useful even if the larger decision is not ready.', 'Create a 15-minute agenda with one decision question and a clear stop point.', 'Text'],
      [trigger ? 'Lead with something specific' : 'Useful pause with permission', trigger ? 'Center something specific Mike can bring or act on, then connect it to the prospect’s stated priority.' : 'Offer a useful artifact, then give the prospect control over timing.', trigger ? `The specific contribution may be relevant to ${priority}; its value should be confirmed, not assumed.` : 'Respectful space protects the relationship while leaving a useful path back.', trigger ? 'Bring or act on the provided capability, then prepare one question about its relevance.' : 'Create a concise recap the prospect can keep; do not manufacture urgency.', trigger ? 'LinkedIn' : 'Mailed card']
    ];
    const plays = data.map((p, index) => {
      const [title, angle, why, asset, primary] = p;
      const cores = [
        `I’ve been thinking about ${priority}. Rather than simply check in${elapsed}, I mapped the questions and tradeoffs I heard in our conversation into a one-page decision aid.`,
        `I want to make sure I understood your situation instead of filling in the gaps. I wrote down three assumptions I’m making about ${priority}, and I’d value a quick correction if any are off.`,
        `I know ${next} may be more time than makes sense right now. I drafted a 15-minute version focused on one decision question, with a clear stopping point.`,
        trigger ? `One specific thing I can bring or act on is this: ${trigger}. I don’t want to assume it would be useful, but I wondered whether it could help with ${priority}.` : `I don’t want to create artificial urgency around ${priority}. I made a short recap you can keep, and I’m happy to leave the timing with you.`
      ];
      const core = cores[index];
      return {
        rank: index + 1, title, strategicAngle: angle, whyNow: why, valueToBring: asset, primaryChannel: primary,
        sequence: [`Lead with the useful idea via ${primary}.`, 'If there is no response, follow once in 4–6 business days with one clarifying question.', 'Then close the loop and leave timing with the prospect.'],
        score: [8, 7, 7, 6][index], rationale: `Strong when it reflects what the prospect actually said. Limited by the missing context that an AI strategist would normally test.`,
        scripts: {
          'Email': `Subject: A practical next step for ${company}\n\n${hello}\n\n${core}\n\nIf it would be useful, I can send it over. If priorities have shifted, just tell me and I’ll adjust.\n\nMike`,
          'Call opener': `${hello} this is Mike. ${core} I have one idea that may make the decision easier. Do you have a minute for me to explain it, and you can tell me if it’s useful?`,
          'Voicemail': `${hello} this is Mike. ${core} I’ll send a short note with the idea. If it’s relevant, we can decide on a useful next step.`,
          'Text': `${hello} Mike here. ${core} Would it be useful if I sent the short version?`,
          'LinkedIn': `${hello} ${core} Happy to share the short version if it would help—no need to make time for a call first. —Mike`,
          'Mailed card': `${hello}\n\n${core} I wanted to leave the idea with you without adding another meeting to your calendar. If it’s useful, I’m easy to reach.\n\nMike`,
          'Gift/leave-behind': `${hello}\n\nI created this simple decision aid around ${priority} for you. I hope it saves you a little time. There’s no expectation attached; if it raises a useful question, I’m happy to help.\n\nMike`
        }
      };
    });
    return { diagnosis: `AI strategy is unavailable, so these plays use only the facts provided. They avoid invented proof or urgency and focus on making the next contact useful to ${company}.`, assumptions: ['Assumption: the prospect has not asked Mike to stop contact.'], plays };
  }

  async function generate(input) {
    const controller = typeof AbortController === 'function' ? new AbortController() : null;
    const timeout = setTimeout(() => controller && controller.abort(), 180000);
    try {
      const response = await fetch('/api/micro-ai', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token: '', messages: promptFor(input) }),
        signal: controller ? controller.signal : undefined
      });
      if (!response.ok) throw new Error(`AI service returned ${response.status}.`);
      const body = await response.json();
      return normalize(parseJsonResponse(body));
    } finally { clearTimeout(timeout); }
  }

  function renderReasons() {
    reasonList.innerHTML = state.data.plays.map((play, index) => `<button type="button" class="reason-card ${index === state.selected ? 'active' : ''}" data-index="${index}" aria-pressed="${index === state.selected}"><span class="score">${play.score}<span>/10</span></span><span><span class="reason-title">${play.rank}. ${escapeHtml(play.title)}</span><span class="reason-why">${escapeHtml(play.strategicAngle)}</span><span class="reason-meta">${escapeHtml(play.primaryChannel)} · ${escapeHtml(play.whyNow)}</span></span><span class="arrow" aria-hidden="true">→</span></button>`).join('');
    reasonList.querySelectorAll('.reason-card').forEach((button) => button.addEventListener('click', () => {
      state.selected = Number(button.dataset.index); state.channel = state.data.plays[state.selected].primaryChannel; renderAll();
    }));
  }

  function renderScore() {
    const play = state.data.plays[state.selected];
    const assumptions = state.data.assumptions.length ? `<p><strong>Assumptions:</strong> ${escapeHtml(state.data.assumptions.join(' '))}</p>` : '';
    scorecard.innerHTML = `<div class="section-label">Why this scores ${play.score}/10</div><p>${escapeHtml(play.rationale)}</p>${assumptions}`;
    scorecard.classList.add('show');
  }

  function renderChannels() {
